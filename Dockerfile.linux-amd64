# syntax=docker/dockerfile:1.7
#
# Base images are pinned by digest for reproducible builds. Update policy: refresh
# digests (docker pull <image>:<tag> && docker inspect --format '{{index .RepoDigests 0}}')
# on a deliberate schedule, not automatically, and re-run the full image test/smoke
# suite before merging a digest bump.

FROM node:22-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3 AS client-builder
WORKDIR /app/client

COPY client/package.json client/package-lock.json ./
RUN npm ci

COPY client/ ./
RUN npm run build

FROM rust:1-bookworm@sha256:77fac8b98f9f46062bb680b6d25d5bcaabfc400143952ebc572e924bcbedc3fa AS server-builder
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends pkg-config libssl-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY server-rs/ server-rs/
RUN cargo build --release --manifest-path server-rs/Cargo.toml

FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818 AS ffmpeg-builder
ARG FFMPEG_URL=https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz
WORKDIR /tmp/ffmpeg

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl xz-utils tar \
    && rm -rf /var/lib/apt/lists/* \
    && curl -L --fail --show-error -A "Mozilla/5.0 (X11; Linux x86_64) curl" --output ffmpeg.tar.xz "$FFMPEG_URL" \
    && curl -L --fail --show-error -A "Mozilla/5.0 (X11; Linux x86_64) curl" --output ffmpeg.tar.xz.md5 "${FFMPEG_URL}.md5" \
    && echo "$(cat ffmpeg.tar.xz.md5 | awk '{print $1}')  ffmpeg.tar.xz" | md5sum -c - \
    && tar -xJf ffmpeg.tar.xz --strip-components=1 --wildcards --no-anchored "*/ffmpeg" "*/ffprobe" \
    && chmod +x ffmpeg ffprobe \
    && ./ffmpeg -version && ./ffprobe -version

FROM python:3.12-slim-bookworm@sha256:d50fb7611f86d04a3b0471b46d7557818d88983fc3136726336b2a4c657aa30b AS boogiemix-builder
ARG BOOGIEMIX_PRIME_MODEL=1
WORKDIR /opt/boogiebox/resources/Services/boogiemix/python

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential git ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

COPY Services/boogiemix/python/ ./
RUN chmod +x bootstrap_env.sh \
    && if [ "$BOOGIEMIX_PRIME_MODEL" = "1" ]; then \
         ./bootstrap_env.sh --cpu-only --prime-model --venv .venv; \
       else \
         ./bootstrap_env.sh --cpu-only --venv .venv; \
       fi \
    && find . -type d -name "__pycache__" -prune -exec rm -rf {} + \
    && find . -type f -name "*.pyc" -delete

FROM python:3.12-slim-bookworm@sha256:d50fb7611f86d04a3b0471b46d7557818d88983fc3136726336b2a4c657aa30b AS runtime

LABEL org.opencontainers.image.title="BoogieBox"
LABEL org.opencontainers.image.description="BoogieBox Linux amd64 server with CPU-only BoogieMix deep analysis"

ENV BOOGIEBOX_CONFIG_DIR=/var/lib/boogiebox \
    BOOGIEBOX_DATA_DIR=/var/lib/boogiebox/data \
    BOOGIEBOX_FFMPEG_DIR=/opt/boogiebox/resources/ffmpeg \
    BOOGIEBOX_LOG_DIR=/var/lib/boogiebox/logs \
    BOOGIEBOX_LOG_LEVEL=info \
    TORCH_HOME=/var/lib/boogiebox/model-cache/torch \
    PORT=3001

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates gosu libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system boogiebox \
    && useradd --system --gid boogiebox --home-dir /var/lib/boogiebox --shell /usr/sbin/nologin boogiebox \
    && mkdir -p /opt/boogiebox/resources/ffmpeg /var/lib/boogiebox/data /var/lib/boogiebox/logs /var/lib/boogiebox/model-cache/torch /var/lib/boogiebox/boogiemix \
    && chown -R boogiebox:boogiebox /var/lib/boogiebox

WORKDIR /opt/boogiebox

COPY --from=server-builder /app/server-rs/target/release/boogiebox-server /opt/boogiebox/boogiebox-server
COPY --from=client-builder /app/client/build /opt/boogiebox/client/build
COPY --from=ffmpeg-builder /tmp/ffmpeg/ffmpeg /tmp/ffmpeg/ffprobe /opt/boogiebox/resources/ffmpeg/
COPY --from=boogiemix-builder /opt/boogiebox/resources/Services/boogiemix/python /opt/boogiebox/resources/Services/boogiemix/python
COPY docker/linux-amd64/entrypoint.sh /usr/local/bin/boogiebox-entrypoint

RUN chmod +x /opt/boogiebox/boogiebox-server /opt/boogiebox/resources/ffmpeg/ffmpeg /opt/boogiebox/resources/ffmpeg/ffprobe /usr/local/bin/boogiebox-entrypoint \
    && chown -R root:root /opt/boogiebox

VOLUME ["/var/lib/boogiebox"]
EXPOSE 3001

ENTRYPOINT ["/usr/local/bin/boogiebox-entrypoint"]
CMD []
