[Unit]
Description=BoogieBox Music Server
After=network.target

[Service]
Type=simple
User=boogiebox
WorkingDirectory=/opt/boogiebox
ExecStart=/opt/boogiebox/boogiebox-server
Restart=on-failure
RestartSec=5
Environment=BOOGIEBOX_CONFIG_DIR=/var/lib/boogiebox
Environment=BOOGIEBOX_DATA_DIR=/var/lib/boogiebox/data
Environment=TORCH_HOME=/var/lib/boogiebox/model-cache/torch

[Install]
WantedBy=multi-user.target
