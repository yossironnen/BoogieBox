{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for BoogieBox desktop app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-probe-server",
    "allow-discover-servers",
    "allow-start-packaged-server",
    "allow-stop-packaged-server",
    "allow-packaged-server-status",
    "allow-get-config",
    "allow-set-server-url",
    "allow-select-folder",
    "allow-audio-command",
    "allow-audio-devices",
    "allow-audio-settings",
    "allow-audio-save-settings",
    "allow-machine-name",
    "shell:allow-open",
    "shell:allow-spawn",
    "dialog:default",
    "process:default",
    "fs:default"
  ]
}
